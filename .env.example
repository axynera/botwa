PORT=8000
HOST=0.0.0.0

# Admin panel: /plugins dan /console
# Web admin login
WA_WEB_USERNAME=admin
WA_WEB_PASSWORD=change-this-password
WA_WEB_SESSION_TTL_MS=86400000

# WhatsApp
WA_AUTO_READ=true
WA_AI_AUTO_REPLY=true
WA_SESSION_DIR=/data/axynera-wa-session
WA_PLUGIN_RELOAD_MS=5000
WA_CONSOLE_MAX_LOGS=500

# Auto download gambar masuk ke storage persistent
WA_AUTO_DOWNLOAD_IMAGES=true
WA_MEDIA_TTL_MS=86400000
AXYNITY_AUTO_REACTION=true
# WA_MEDIA_DIR=/data/axynera-wa-session/media

# Jaga presence online + update Tentang otomatis
WA_AUTO_ONLINE=true
WA_PRESENCE_INTERVAL_MS=60000
WA_ABOUT_UPDATE_MS=60000
WA_ABOUT_FORCE_REFRESH_MS=300000
WA_ABOUT_PREFIX=🤖 Axynera Ai⌚ Aktif

WA_PLUGIN_DIR=/app/plugins

# Nera AI
AXYNITY_BASE_URL=https://api.axynera.my.id
AXYNITY_MODEL=Nera-Plus.5
AXYNITY_DEFAULT_MODE=cepat
AXYNITY_TIMEOUT_MS=120000
AXYNITY_STREAM_EDIT_MS=1200
AXYNITY_THINK_ANIMATION_MS=900

# Maksimal ukuran gambar yang dikirim ke Nera sebagai data:image base64
AXYNITY_MAX_IMAGE_BYTES=8388608

# Opsional jika API Nera nanti memakai Authorization Bearer
AXYNITY_API_KEY=

# Memory Nera per user/LID. 20 turn = maksimal 40 pesan user+assistant.
AXYNITY_MEMORY_TURNS=20

# Default tersimpan bersama WA_SESSION_DIR agar ikut persistent volume.
# AXYNITY_MEMORY_FILE=/data/axynera-wa-session/nera-memory.json

BODY_LIMIT_BYTES=2097152
KEEP_ALIVE_TIMEOUT_MS=75000


# Sticker converter
WA_STICKER_MAX_INPUT_BYTES=26214400
WA_STICKER_MAX_OUTPUT_BYTES=500000
WA_STICKER_MAX_SECONDS=6
# WA_STICKER_PENDING_FILE=/data/axynera-wa-session/sticker-pending.json


# Appwrite persistent storage (optional until connected)
# The bot auto-creates the bucket if it does not exist.
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=botwa
APPWRITE_DATABASE_ID=botwa
APPWRITE_USERS_COLLECTION_ID=users
APPWRITE_MEMORIES_COLLECTION_ID=memories
APPWRITE_SESSIONS_COLLECTION_ID=user_sessions
APPWRITE_PLUGIN_SYNC_MS=30000
APPWRITE_TEMP_TTL_MS=900000

# Runtime paths backed by Appwrite
WA_PLUGIN_DIR=/app/plugins
WA_SESSION_DIR=/data/axynera-wa-session
